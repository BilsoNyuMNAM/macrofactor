datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id                   Int      @id @default(1)
  biologicalSex        String   @default("male")
  birthDate            String   @default("1998-05-15")
  heightCm             Float    @default(178.0)
  initialWeightKg      Float    @default(78.0)
  baselineTdee         Int      @default(2340)
  bmrEquation          String   @default("macrofactor_2024")
  checkInDay           Int      @default(1) // 0=Sun, 1=Mon, ..., 6=Sat
  fastCheckIn          Boolean  @default(false)
  weightUnit           String   @default("kg")
  energyUnit           String   @default("kcal")
  trendAlgorithm       String   @default("v2_kalman")
  expenditureAlgorithm String   @default("v3")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_profile")
}

model Goal {
  goalId               Int          @id @default(autoincrement())
  goalType             String       @default("weight_loss") // "weight_loss" | "weight_gain" | "maintenance" (also accepts "fat_loss" | "muscle_gain")
  startWeightKg        Float
  targetWeightKg       Float? // null for maintenance
  initialTrendWeightKg Float        @default(78.0) // Trend weight snapshot on start date
  finalTrendWeightKg   Float? // Trend weight snapshot when completed/abandoned
  weeklyRatePercent    Float        @default(-0.50) // e.g. -0.50 for -0.50% BW/week
  weeklyRateKg         Float // calculated: (|weeklyRatePercent| / 100) * initialTrendWeightKg
  startDate            String // YYYY-MM-DD
  endDate              String? // YYYY-MM-DD (null while active)
  targetDate           String? // YYYY-MM-DD (projected completion ETA)
  etaWeeks             Int? // Estimated weeks to goal
  status               String       @default("active") // "active" | "completed" | "abandoned" | "paused"
  scaleReached         Boolean      @default(false)
  hidden               Boolean      @default(false)
  createdAt            DateTime     @default(now())
  weeklyPlans          WeeklyPlan[]

  @@map("goals")
}

model ScaleWeightEntry {
  entryId   Int      @id @default(autoincrement())
  logDate   String // YYYY-MM-DD
  loggedAt  DateTime @default(now())
  weightKg  Float
  source    String   @default("manual")
  notes     String?
  createdAt DateTime @default(now())

  @@index([logDate])
  @@map("scale_weight_entries")
}

model WeightTrendEntry {
  logDate           String   @id // YYYY-MM-DD
  trendWeightKg     Float
  velocityKgPerDay  Float    @default(0.0)
  noiseRangeLowerKg Float?
  noiseRangeUpperKg Float?
  algorithmVersion  String   @default("v2_kalman")
  calculatedAt      DateTime @default(now())

  @@map("weight_trend_entries")
}

model TdeeEntry {
  logDate          String   @id // YYYY-MM-DD
  expenditureKcal  Int
  status           String   @default("updating") // "updating" | "holding" | "static"
  tdeeDeltaKcal    Int      @default(0)
  fluxLowerKcal    Int
  fluxUpperKcal    Int
  algorithmVersion String   @default("v3")
  isManualOverride Boolean  @default(false)
  calculatedAt     DateTime @default(now())

  @@map("tdee_entries")
}

model TdeeOverride {
  overrideId       Int      @id @default(autoincrement())
  startDate        String // YYYY-MM-DD
  endDate          String? // NULL = ongoing
  overrideTdeeKcal Int
  reason           String?
  createdAt        DateTime @default(now())

  @@map("tdee_overrides")
}

model DailyNutritionRollup {
  logDate           String   @id // YYYY-MM-DD
  totalCaloriesKcal Int      @default(0)
  isFasting         Boolean  @default(false)
  isPartial         Boolean  @default(false)
  isLoggingComplete Boolean  @default(true)
  notes             String?
  updatedAt         DateTime @updatedAt

  @@map("daily_nutrition_rollups")
}

model WeeklyPlan {
  planId            Int                  @id @default(autoincrement())
  goalId            Int
  goal              Goal                 @relation(fields: [goalId], references: [goalId], onDelete: Cascade)
  startDate         String // YYYY-MM-DD
  endDate           String // YYYY-MM-DD
  checkInDate       String // YYYY-MM-DD
  programStyle      String               @default("coached")
  dietStyle         String               @default("balanced")
  proteinPrefGPerKg Float                @default(2.0)
  tdeeAtCheckin     Int
  weightAtCheckin   Float
  dailyDeficitKcal  Int
  weeklyBudgetKcal  Int
  targetCalories    Int // locked daily calorie budget
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  dailyTargets      DailyCalorieTarget[]

  @@map("weekly_plans")
}

model DailyCalorieTarget {
  targetId           Int        @id @default(autoincrement())
  planId             Int
  plan               WeeklyPlan @relation(fields: [planId], references: [planId], onDelete: Cascade)
  dayOfWeek          Int // 0=Sun .. 6=Sat
  targetCalories     Int
  isHigherCalorieDay Boolean    @default(false)

  @@unique([planId, dayOfWeek])
  @@map("daily_macro_targets")
}

model CheckinHistory {
  checkinId           Int      @id @default(autoincrement())
  checkinDate         String // YYYY-MM-DD
  previousPlanId      Int?
  newPlanId           Int
  loggedNutritionDays Int
  weighInDays         Int
  tdeeSnapshot        Int
  trendWeightSnapshot Float
  adherenceRating     Float?
  coachNotes          String?
  completedAt         DateTime @default(now())

  @@map("checkin_history")
}
